# Copie este arquivo para .env.test somente depois de criar um projeto Supabase
# separado para homologacao. Nunca use a URL do projeto de producao aqui.
VITE_MAESTRO_ENV=test
VITE_SUPABASE_URL=https://SEU-PROJETO-DE-HOMOLOGACAO.supabase.co
VITE_SUPABASE_ANON_KEY=COLOQUE_A_CHAVE_PUBLICAVEL_DE_HOMOLOGACAO
VITE_MAESTRO_AUTH_PROVIDER=supabase
VITE_MAESTRO_DATA_PROVIDER=supabase

# Compatibilidade com modulos ainda nao migrados.
VITE_BASE44_APP_ID=69b0ac7e08d578f9756170a0
VITE_BASE44_APP_BASE_URL=https://dominioperformance.base44.app
