{
  "name": "FinancialCategory",
  "type": "object",
  "properties": {
    "parent_key": {
      "type": "string",
      "description": "Chave da categoria pai (ex: fee, production, salary, etc). Vazio se for n\u00edvel raiz customizado."
    },
    "parent_id": {
      "type": "string",
      "description": "ID da categoria pai (para subcategorias de subcategorias)"
    },
    "name": {
      "type": "string",
      "description": "Nome da subcategoria"
    },
    "type": {
      "type": "string",
      "enum": [
        "revenue",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "type"
  ]
}