{
  "name": "CostCenter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do centro de custo"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "description": "Cor do centro de custo (hex)"
    },
    "monthly_budget": {
      "type": "number",
      "default": 0,
      "description": "Or\u00e7amento mensal do centro de custo (R$)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}