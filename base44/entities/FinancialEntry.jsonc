{
  "name": "FinancialEntry",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "revenue",
        "expense",
        "transfer"
      ],
      "default": "revenue"
    },
    "title": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "fee",
        "production",
        "media",
        "supplier",
        "salary",
        "tax",
        "tools",
        "rent",
        "other"
      ]
    },
    "subcategory_id": {
      "type": "string",
      "description": "ID da subcategoria (FinancialCategory)"
    },
    "subcategory_name": {
      "type": "string",
      "description": "Nome da subcategoria para exibi\u00e7\u00e3o"
    },
    "expense_type": {
      "type": "string",
      "enum": [
        "fixed",
        "variable"
      ],
      "description": "Gasto fixo ou vari\u00e1vel (apenas despesas)"
    },
    "installment_group": {
      "type": "string",
      "description": "ID do grupo de parcelas (mesmo valor para todas as parcelas)"
    },
    "installment_current": {
      "type": "number",
      "description": "N\u00famero da parcela atual (ex: 1)"
    },
    "installment_total": {
      "type": "number",
      "description": "Total de parcelas (ex: 3)"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "competence_date": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "billing_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "forecast",
        "pending",
        "overdue",
        "paid",
        "cancelled"
      ],
      "default": "forecast"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "cost_center": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "has_invoice": {
      "type": "boolean",
      "default": false
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "fee_contract",
        "proposal",
        "production"
      ],
      "default": "manual"
    },
    "reference_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "amount",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}