{
  "name": "JobTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00edtulo padr\u00e3o do job gerado por este template"
    },
    "team": {
      "type": "string",
      "description": "Equipe vinculada a este template (legado)"
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Equipes vinculadas a este template"
    },
    "content_type": {
      "type": "string",
      "description": "Tipo de conte\u00fado principal (legado)"
    },
    "content_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de conte\u00fado aplic\u00e1veis a este template"
    },
    "default_responsible_role": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "responsible_id": {
            "type": "string"
          },
          "responsible_name": {
            "type": "string"
          },
          "responsible_role": {
            "type": "string"
          },
          "complete_at_status": {
            "type": "string",
            "description": "Etapa do job que conclui automaticamente esta tarefa"
          },
          "notify_on_status": {
            "type": "string",
            "description": "Etapa do job que dispara notifica\u00e7\u00e3o para o respons\u00e1vel desta tarefa"
          },
          "days_before_post": {
            "type": "number"
          },
          "order": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}