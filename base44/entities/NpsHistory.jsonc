{
  "name": "NpsHistory",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "late_post",
        "manual_change",
        "monthly_entry"
      ],
      "description": "Tipo do evento"
    },
    "delta": {
      "type": "number",
      "description": "Varia\u00e7\u00e3o aplicada (-1 para atraso, etc)"
    },
    "score_before": {
      "type": "number"
    },
    "score_after": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "event_type",
    "delta"
  ]
}