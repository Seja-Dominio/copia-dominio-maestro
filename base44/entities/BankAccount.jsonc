{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "digital",
        "cash"
      ],
      "default": "checking"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "color": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}